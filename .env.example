# ===== DRIVER HUB — Environment variables example =====
# Copy to .env and fill in. NEVER commit real secrets.

# --- General ---
NODE_ENV=development
APP_NAME=Driver Hub
# Comma-separated list of allowed CORS origins (the hosted Mini App / admin URLs)
CORS_ORIGINS=http://localhost:5173,http://localhost:5174

# --- Database ---
# Local PostgreSQL via docker compose: docker compose -f docker/docker-compose.yml up -d
DATABASE_URL=postgresql://driverhub:driverhub@localhost:5432/driverhub?schema=public

# --- Redis (used by worker queue; optional in dev — falls back to in-memory queue) ---
REDIS_URL=redis://localhost:6379

# --- Telegram ---
# Create a bot: message @BotFather -> /newbot. Token looks like 123456:ABC-DEF...
TELEGRAM_BOT_TOKEN=
# Public URL of the Telegram Mini App (production). Dev uses VITE_TG_MOCK=1 in a browser.
TELEGRAM_WEBAPP_URL=https://your-mini-app.example.com

# --- Auth ---
# Generate with: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET=
JWT_EXPIRES_IN=7d

# --- AI Driver Coach ---
# Optional. Deterministic engine (real, on driver's own data) is used when unset.
# Set to 'anthropic' provider with an API key to enable natural-language chat.
AI_PROVIDER=deterministic
AI_API_KEY=
AI_MODEL=claude-sonnet-5
AI_MAX_DAILY_QUERIES=50

# --- Payments ---
# Interface only until a processor is configured. Options: local | telegram_stars | none
PAYMENT_PROVIDER=none
PAYMENT_PROVIDER_KEY=
PAYMENT_WEBHOOK_SECRET=

# --- Storage (receipts, marketplace images, logos) ---
# 'local' writes to ./uploads. For production use an S3-compatible provider.
STORAGE_PROVIDER=local
STORAGE_ENDPOINT=
STORAGE_ACCESS_KEY=
STORAGE_SECRET_KEY=
STORAGE_BUCKET=
STORAGE_PUBLIC_URL=

# --- Admin bootstrap ---
# First admin created on seed/startup with these credentials (change before prod).
ADMIN_EMAIL=admin@driverhub.uz
ADMIN_PASSWORD=ChangeMe_12345

# --- Demo mode ---
# When enabled, the demo driver sees clearly-labeled DEMO DATA (never mixed with real records).
DEMO_MODE=false

# --- API ---
API_PORT=4000
API_HOST=0.0.0.0

# --- Worker ---
WORKER_CRON_REPORTS_DAILY=38 0 * * *
WORKER_CRON_SCORE_HOURLY=7 * * * *
# DEFAULT_MARKETPLACE_COMMISSION_PERCENT is configurable at runtime via admin settings.
DEFAULT_MARKETPLACE_COMMISSION_PERCENT=3