{
  "name": "driver-hub",
  "version": "0.1.0",
  "private": true,
  "description": "DRIVER HUB — Driver Operating System inside Telegram. Ko'proq toping. Kamroq sarflang.",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "build": "npm run build --workspaces --if-present",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "lint": "npm run lint --workspaces --if-present",
    "test:unit": "npm run test:unit --workspaces --if-present",
    "gen": "prisma generate",
    "db:migrate": "prisma migrate dev",
    "db:deploy": "prisma migrate deploy",
    "db:migration": "node -e \"require('./packages/database/dist/scripts/make-migration').run()\"",
    "db:seed": "npm run db:seed --workspace @driverhub/database",
    "dev:api": "npm run dev --workspace @driverhub/api",
    "dev:web": "npm run dev --workspace @driverhub/web",
    "dev:admin": "npm run dev --workspace @driverhub/admin",
    "dev:bot": "npm run dev --workspace @driverhub/bot",
    "dev:worker": "npm run dev --workspace @driverhub/worker"
  },
  "devDependencies": {
    "prettier": "^3.3.3",
    "typescript": "^5.6.3",
    "vitest": "^3.0.5",
    "eslint": "^9.17.0",
    "eslint-config-prettier": "^9.1.0",
    "@typescript-eslint/eslint-plugin": "^8.19.0",
    "@typescript-eslint/parser": "^8.19.0"
  },
  "engines": {
    "node": ">=20"
  }
}