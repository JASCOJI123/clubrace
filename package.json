{
  "name": "driver-hub",
  "version": "0.1.0",
  "private": true,
  "description": "DRIVER HUB — Driver Operating System inside Telegram. Ko'proq toping. Kamroq sarflang.",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "build": "npm run build:packages && npm run build:apps",
    "typecheck": "npm run build:packages && npm run typecheck:all",
    "lint": "npm run lint --workspaces --if-present",
    "test:unit": "npm run test:unit --workspaces --if-present",
    "build:packages": "npm run build -w @driverhub/database -w @driverhub/config -w @driverhub/telegram -w @driverhub/ai -w @driverhub/types -w @driverhub/validation",
    "build:apps": "npm run build -w @driverhub/api -w @driverhub/bot -w @driverhub/worker -w @driverhub/web -w @driverhub/admin",
    "typecheck:all": "npm run typecheck --workspaces --if-present",
    "gen": "prisma generate",
    "db:migrate": "prisma migrate dev",
    "db:deploy": "prisma migrate deploy",
    "db:migration": "node -e \"require('./packages/database/dist/scripts/make-migration').run()\"",
    "db:seed": "npm run db:seed --workspace @driverhub/database",
    "dev:api": "npm run dev --workspace @driverhub/api",
    "dev:web": "npm run dev --workspace @driverhub/web",
    "dev:admin": "npm run dev --workspace @driverhub/admin",
    "dev:bot": "npm run dev --workspace @driverhub/bot",
    "dev:worker": "npm run dev --workspace @driverhub/worker"
  },
  "devDependencies": {
    "prettier": "^3.3.3",
    "typescript": "^5.6.3",
    "vitest": "^3.0.5",
    "eslint": "^9.17.0",
    "eslint-config-prettier": "^9.1.0",
    "@typescript-eslint/eslint-plugin": "^8.19.0",
    "@typescript-eslint/parser": "^8.19.0"
  },
  "engines": {
    "node": ">=20"
  },
  "allowScripts": {
    "esbuild@0.28.2": true,
    "prisma@6.19.3": true,
    "@prisma/engines@6.19.3": true,
    "msgpackr-extract@3.0.4": true,
    "@prisma/client@6.19.3": true
  }
}
