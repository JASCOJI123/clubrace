# ============================================================================
# DRIVER HUB — production environment (Docker stack on the Oracle VM)
# Copy to docker/.env and fill in. NEVER commit real secrets.
#   cp docker/.env.prod.example docker/.env && nano docker/.env
# ============================================================================

# ---- Postgres (managed by the compose stack; change together) ----
# POSTGRES_PASSWORD is read by docker-compose for the `db` service and by
# DATABASE_URL below (host `db` = the compose service name, not localhost).
POSTGRES_PASSWORD=REPLACE_WITH_STRONG_PASSWORD
DATABASE_URL=postgresql://driverhub:REPLACE_WITH_STRONG_PASSWORD@db:5432/driverhub?schema=public

# ---- Redis (in-stack) ----
REDIS_URL=redis://redis:6379

# ---- Telegram ----
# Create a bot: message @BotFather -> /newbot. Token looks like 123456:ABC-DEF...
# Without a token the bot service exits (production requires it).
TELEGRAM_BOT_TOKEN=
# Public HTTPS URL shown in Telegram as the Mini App. Must point at your tunnel.
TELEGRAM_WEBAPP_URL=https://your-tunnel-domain.trycloudflare.com
# Optional: run the bot via webhook instead of long-polling.
WEBHOOK_URL=
WEBHOOK_SECRET=

# ---- Auth ----
# Generate with: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET=REPLACE_WITH_STRONG_JWT_SECRET
JWT_EXPIRES_IN=7d

# ---- Admin bootstrap ----
# First admin is created automatically on first boot (packages/database/src/bootstrap.ts).
ADMIN_EMAIL=admin@driverhub.uz
ADMIN_PASSWORD=REPLACE_WITH_STRONG_ADMIN_PASSWORD

# ---- AI Driver Coach (optional — deterministic engine used when unset) ----
AI_PROVIDER=deterministic
AI_API_KEY=
AI_MODEL=claude-sonnet-5
AI_MAX_DAILY_QUERIES=50

# ---- Payments (interface only until a processor is configured) ----
PAYMENT_PROVIDER=none
PAYMENT_PROVIDER_KEY=
PAYMENT_WEBHOOK_SECRET=

# ---- Storage (receipts, marketplace images, logos) ----
# 'local' writes to the docker volume `uploads` (persists across redeploys).
STORAGE_PROVIDER=local
STORAGE_ENDPOINT=
STORAGE_ACCESS_KEY=
STORAGE_SECRET_KEY=
STORAGE_BUCKET=
STORAGE_PUBLIC_URL=

# ---- CORS ----
# Mini App + Admin call /api on the same origin, so this is a safety net.
CORS_ORIGINS=https://your-tunnel-domain.trycloudflare.com

# ---- General ----
NODE_ENV=production
DEMO_MODE=false
APP_NAME=Driver Hub

# ---- API ----
API_PORT=4000
API_HOST=0.0.0.0

# ---- Worker ----
WORKER_CRON_REPORTS_DAILY=38 0 * * *
WORKER_CRON_SCORE_HOURLY=7 * * * *
DEFAULT_MARKETPLACE_COMMISSION_PERCENT=3

# ---- Cloudflare Tunnel (from the Zero Trust dashboard -> Tunnels -> create) ----
CLOUDFLARE_TUNNEL_TOKEN=